{
  "name": "restaurant-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0 <23" },
  "scripts": {
    "dev": "node --env-file=.env.local --env-file-if-exists=.env.deepseek.local --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "migrate:production": "node dist/scripts/migrate.js",
    "test": "node --env-file=.env.local --import tsx --test --test-concurrency=1 test/*.test.ts",
    "test:ci": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "contract": "node scripts/validate-contract.mjs",
    "sites:dev": "node --env-file=.env.local --import tsx src/sites-index.ts",
    "sites:start": "node dist/src/sites-index.js",
    "setup:local": "node scripts/setup-local.mjs",
    "assets:cleanup": "node --env-file=.env.local --import tsx scripts/cleanup-assets.ts",
    "mail:once": "node --env-file=.env.local --import tsx src/mail-worker.ts --once"
  },
  "dependencies": {
    "fastify": "^5.0.0", "@fastify/cookie": "^11.0.0", "@fastify/helmet": "^13.0.0", "@fastify/rate-limit": "^10.0.0",
    "pg": "^8.0.0", "argon2": "^0.44.0", "ajv": "^8.0.0", "ajv-formats": "^3.0.0", "nodemailer": "10.5.0", "sharp": "0.35.5", "pdf-lib": "^1.17.1", "@aws-sdk/client-s3": "^3.0.0", "parse5": "^7.3.0", "css-tree": "^3.0.0"
  },
  "devDependencies": { "typescript": "~5.9.0", "tsx": "^4.0.0", "@types/node": "^22.0.0", "@types/pg": "^8.0.0", "@types/nodemailer": "8.0.2", "@types/css-tree": "^2.3.0" }
}
