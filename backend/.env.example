# Copy to a private .env.local; never commit real configuration.
NODE_ENV=development
DATABASE_URL=postgresql://restaurant_app:CHANGE_ME@127.0.0.1:55439/restaurant_dev
MIGRATION_DATABASE_URL=postgresql://restaurant_owner:CHANGE_ME@127.0.0.1:55439/restaurant_dev
# Remote PostgreSQL requires ?sslmode=verify-full and exactly one CA source.
# Railway: DATABASE_SSL_CA contains the trusted PEM certificate text (real or escaped newlines).
# DATABASE_SSL_CA=
# Local alternative: DATABASE_SSL_CA_FILE=../.workbuddy/runtime/supabase/prod-ca-2021.crt
# APP_ORIGIN must be the actual frontend HTTPS origin, not the backend URL or example.com.
# Railway private networking: HOST=:: and PORT=4000; frontend proxy uses the same port.
# Local PG16 tests stay on 55439. Isolated PG17 tests require TEST_PG_PORT=55440 and TEST_PG_MAJOR=17.
TEST_DATABASE_URL=postgresql://restaurant_test_app:CHANGE_ME@127.0.0.1:55439/restaurant_test
TEST_MIGRATION_DATABASE_URL=postgresql://restaurant_test_owner:CHANGE_ME@127.0.0.1:55439/restaurant_test
APP_DB_ROLE=restaurant_app
APP_ORIGIN=https://localhost:5173
HOST=127.0.0.1
PORT=4000
EMAIL_MODE=disabled
# Save the real key only in backend/.env.deepseek.local or injected private env.
# DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
SITE_PORT=4174
SITE_PUBLIC_ORIGIN=http://localhost:4174
# Local publication only. Formal platform domain/CDN/HTTPS deployment is not configured.
# Real local storage for development only; production rejects local.
STORAGE_MODE=local
STORAGE_LOCAL_ROOT=../.workbuddy/runtime/assets
# Production S3-compatible private object storage uses the SDK credential chain.
# STORAGE_MODE=s3
# S3_REGION=
# S3_BUCKET=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
TOKEN_PEPPER=GENERATE_AT_LEAST_32_RANDOM_BYTES
CURSOR_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
OUTBOX_ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS
# Production requires EMAIL_MODE=postmark (HTTPS) or smtp; never disabled.
# Railway Free/Trial/Hobby blocks SMTP. Use Postmark HTTPS and a Server API Token, not an SMTP token.
# EMAIL_MODE=postmark
# POSTMARK_SERVER_TOKEN=
# SMTP_FROM=noreply@YOUR_VERIFIED_DOMAIN
# HTTPS mode reuses SMTP_FROM as the sender address for compatibility; SMTP_HOST/USER/PASS are not required.
# EMAIL_MODE=smtp requires the complete SMTP configuration below and a host that permits SMTP egress.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
