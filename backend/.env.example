# Copy to a private .env.local; never commit real configuration.
NODE_ENV=development
DATABASE_URL=postgresql://restaurant_app:CHANGE_ME@127.0.0.1:55439/restaurant_dev
MIGRATION_DATABASE_URL=postgresql://restaurant_owner:CHANGE_ME@127.0.0.1:55439/restaurant_dev
TEST_DATABASE_URL=postgresql://restaurant_test_app:CHANGE_ME@127.0.0.1:55439/restaurant_test
TEST_MIGRATION_DATABASE_URL=postgresql://restaurant_test_owner:CHANGE_ME@127.0.0.1:55439/restaurant_test
APP_DB_ROLE=restaurant_app
APP_ORIGIN=https://localhost:5173
HOST=127.0.0.1
PORT=4000
EMAIL_MODE=disabled
TOKEN_PEPPER=GENERATE_AT_LEAST_32_RANDOM_BYTES
CURSOR_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
OUTBOX_ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS
# production requires EMAIL_MODE=smtp and the complete SMTP configuration.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
