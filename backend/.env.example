# Copy to a private .env.local; never commit real configuration.
NODE_ENV=development
DATABASE_URL=postgresql://restaurant_app:CHANGE_ME@127.0.0.1:55439/restaurant_dev
MIGRATION_DATABASE_URL=postgresql://restaurant_owner:CHANGE_ME@127.0.0.1:55439/restaurant_dev
TEST_DATABASE_URL=postgresql://restaurant_test_app:CHANGE_ME@127.0.0.1:55439/restaurant_test
TEST_MIGRATION_DATABASE_URL=postgresql://restaurant_test_owner:CHANGE_ME@127.0.0.1:55439/restaurant_test
APP_DB_ROLE=restaurant_app
APP_ORIGIN=https://localhost:5173
HOST=127.0.0.1
PORT=4000
EMAIL_MODE=disabled
# Save the real key only in backend/.env.deepseek.local or injected private env.
# DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
SITE_PORT=4174
SITE_PUBLIC_ORIGIN=http://localhost:4174
# Local publication only. Formal platform domain/CDN/HTTPS deployment is not configured.
# Real local storage for development only; production rejects local.
STORAGE_MODE=local
STORAGE_LOCAL_ROOT=../.workbuddy/runtime/assets
# Production S3-compatible private object storage uses the SDK credential chain.
# STORAGE_MODE=s3
# S3_REGION=
# S3_BUCKET=
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
TOKEN_PEPPER=GENERATE_AT_LEAST_32_RANDOM_BYTES
CURSOR_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
OUTBOX_ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS
# production requires EMAIL_MODE=smtp and the complete SMTP configuration.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
