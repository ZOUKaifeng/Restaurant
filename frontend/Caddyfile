{
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /srv

	handle /healthz {
		respond "ok" 200
	}

	handle /api/* {
		reverse_proxy {$BACKEND_UPSTREAM}
	}

	handle {
		route {
			try_files {path} /index.html
			@hashedAssets path_regexp hashedAssets ^/assets/[^/]+-[A-Za-z0-9_-]{8,}\.[A-Za-z0-9]+$
			header @hashedAssets Cache-Control "public, max-age=31536000, immutable"
			header /index.html Cache-Control "no-cache"
			header / Cache-Control "no-cache"
			file_server
		}
	}
}
